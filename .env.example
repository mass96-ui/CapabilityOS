# ============================================================
# CapabilityOS Environment Configuration
# ============================================================

# ----------------------------------------
# Application
# ----------------------------------------
APP_NAME=CapabilityOS API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# ----------------------------------------
# Server
# ----------------------------------------
HOST=0.0.0.0
PORT=8000

# ----------------------------------------
# Security
# ----------------------------------------
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_SECRET_KEY=change-me-to-another-random-64-char-string
JWT_ALGORITHM=HS256

# ----------------------------------------
# Token Expiration
# ----------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=48
EMAIL_VERIFICATION_OTP_EXPIRE_MINUTES=10

# ----------------------------------------
# Database
# ----------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./capabilityos.db

# ----------------------------------------
# Redis (optional)
# ----------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------
# SMTP / Email
# ----------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true

# ----------------------------------------
# CORS
# ----------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----------------------------------------
# Trusted Hosts
# ----------------------------------------
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# ----------------------------------------
# Logging
# ----------------------------------------
LOG_LEVEL=INFO

# ----------------------------------------
# Rate Limiting
# ----------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ----------------------------------------
# Frontend Apps
# ----------------------------------------
NEXT_PUBLIC_APP_NAME=CapabilityOS
API_BASE_URL=http://localhost:8000/api/v1

# ----------------------------------------
# PostgreSQL (Docker)
# ----------------------------------------
POSTGRES_DB=capabilityos
POSTGRES_USER=capabilityos
POSTGRES_PASSWORD=capabilityos
